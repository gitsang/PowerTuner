<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerTuner · 电源策略管理器"
        Width="1200" Height="790" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航 ============ -->
        <Border Grid.Column="0" Background="#FBFBFC" BorderBrush="#E6E7EA" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">

                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,18">
                    <TextBlock Text="PowerTuner" FontSize="20" FontWeight="SemiBold" Foreground="#16181D" />
                    <TextBlock Text="Windows 电源策略管理器" FontSize="11" Foreground="#8A8F99" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock Text="快速方案" FontSize="11" Foreground="#9AA0A8" Margin="10,0,0,8" />
                    <StackPanel x:Name="PresetHost" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="配置分类" FontSize="11" Foreground="#9AA0A8" Margin="10,0,0,8" />

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- ============ 右侧主区 ============ -->
        <DockPanel Grid.Column="1">

            <!-- 顶部：方案选择 + 搜索 -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E6E7EA" BorderThickness="0,0,0,1" Padding="20,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="电源方案" VerticalAlignment="Center" Foreground="#5A5F68" Margin="0,0,10,0" />
                    <ComboBox x:Name="SchemeCombo" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnDup" Grid.Column="2" Content="新建副本" Height="30" Margin="8,0,0,0" Padding="12,0" />

                    <Grid Grid.Column="4">
                        <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Padding="9,0" />
                        <TextBlock x:Name="SearchHint" Text="搜索设置名称…" Foreground="#ADB2B9"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 隐藏项提示条 -->
            <Border x:Name="Banner" DockPanel.Dock="Top" Background="#FFF8E6" BorderBrush="#F2E2B4"
                    BorderThickness="0,0,0,1" Padding="20,10" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="BtnUnhide" DockPanel.Dock="Right" Content="解锁隐藏设置"
                            Height="28" Padding="14,0" Margin="14,0,0,0" />
                    <TextBlock x:Name="BannerText" VerticalAlignment="Center" Foreground="#7A5A10" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- 底部：应用栏 -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E6E7EA" BorderThickness="0,1,0,0" Padding="20,11">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnRevert" Content="撤销更改" Height="32" Padding="16,0" Margin="0,0,8,0" />
                        <Button x:Name="BtnApply" Content="应用更改" Height="32" Padding="20,0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6B7078" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Padding="20,12,20,26">
                <StackPanel x:Name="SettingsHost" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
