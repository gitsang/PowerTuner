<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 发布以 net48 为准（体积小、Win10/11 免装运行时）；
         net8.0-windows 同时编译，用于验证代码可移植性 -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>

    <AssemblyName>PowerTuner</AssemblyName>
    <RootNamespace>PowerTuner</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 版本信息 -->
    <Version>0.1.0</Version>
    <Company>PowerTuner</Company>
    <Product>PowerTuner</Product>
    <Description>Windows 电源策略管理器</Description>
    <Copyright>MIT License</Copyright>

    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- .NET 8 下 GBK/OEM 代码页需要显式注册编码提供程序 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
